{
  "name": "gmgn-bsc-signal-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A maintainable BSC-only Telegram signal bot backed by GMGN OpenAPI.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node --enable-source-maps dist/src/main.js",
    "migrate": "npm run build --silent && node --enable-source-maps dist/src/cli/migrate.js",
    "replay": "npm run build --silent && node --enable-source-maps dist/src/cli/replay.js",
    "acceptance": "npm run build --silent && node --enable-source-maps dist/src/cli/acceptance.js",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "dotenv": "17.4.2",
    "grammy": "1.45.1",
    "pino": "10.3.1",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.1",
    "eslint": "10.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  }
}
