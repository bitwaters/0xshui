# Required for every mode. Obtain this from GMGN and keep it secret.
GMGN_API_KEY=

# Required when telegram.enabled=true. Production mode forces Telegram on.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional deployment override. Docker Compose sets this to true for the
# private Shadow channel without duplicating the full YAML configuration.
# Accepted values: true or false.
# TELEGRAM_ENABLED=true

# Optional. Defaults to config/default.yaml. For private Shadow, copy the default
# to config/local.yaml, enable Telegram there, and point this value at that file.
APP_CONFIG_PATH=config/default.yaml
